# Redis
REDIS_URL=redis://localhost:6379

# Bitget API — UTA (Unified Trading Account) v3
# Napravi API ključ na bitget.com sa dozvolom "Futures Trade" (read+write),
# BEZ dozvole za withdraw, i po mogućnosti s IP whitelistom.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# LLM koji donosi trading odluke — OpenRouter je primarni (shared/llm.js),
# Groq je automatski fallback ako OpenRouter nije postavljen ili ne uspije.
# Barem jedan od dva bloka niže mora biti popunjen.

# OpenRouter (besplatni ":free" modeli)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_SITE_URL=https://github.com/marchini14/marchinisystem

# Groq (besplatni tier) — fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Risk guardrails (shared/risk.js) ---
# Mora biti točno "true" da bi agenti smjeli slati stvarne naloge na Bitget.
# Bilo koja druga vrijednost (ili izostavljeno) = dry-run: pravi tržišni
# podaci + prava LLM odluka, ali BEZ slanja naloga.
LIVE_TRADING=false

# Hard cap ukupnog kapitala (USD) kojim svi agenti zajedno smiju trgovati.
# Dijeli se ravnomjerno po broju agenata u server.js (trenutno 3).
MAX_CAPITAL_USD=150

# Hard cap na leverage bez obzira što LLM predloži.
MAX_LEVERAGE=3

# Ako dnevni gubitak (svi agenti zajedno) pređe ovaj % od MAX_CAPITAL_USD,
# aktivira se kill-switch u Redisu i svi agenti staju dok se ručno ne resetira
# (shared/risk.js: resetKillSwitch()).
DAILY_LOSS_LIMIT_PCT=10

# Cool-down: nakon ovoliko uzastopnih gubitaka zaredom (svi agenti zajedno)
# aktivira se isti kill-switch kao za dnevni limit.
MAX_CONSECUTIVE_LOSSES=4

# Kelly sizing (shared/risk.js: getKellyFraction()) — stvarna povijest
# tradeova iz Redisa, ne pretpostavka. Dok ima manje od KELLY_MIN_TRADES
# zatvorenih tradeova, agenti koriste punu ravnu alokaciju (staro ponašanje).
KELLY_MIN_TRADES=10
KELLY_LOOKBACK_TRADES=50
# Half-Kelly damping — puni Kelly iznos je prevolatilan za pravi račun.
KELLY_DAMPING=0.5
# Hard cap na Kelly udio bez obzira što formula predloži.
KELLY_FRACTION_CAP=0.5
