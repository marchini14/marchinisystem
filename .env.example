# Kopirajte ovu datoteku u ".env" i upišite svoje podatke.
# NIKADA ne dijelite BYBIT_API_SECRET ni ne stavljajte .env na GitHub!

# API ključ subaccounta (kreiran na glavnom računu, SAMO "Trade" dozvola, BEZ withdrawal)
BYBIT_API_KEY=OVDJE_UPISITE_API_KEY
BYBIT_API_SECRET=OVDJE_UPISITE_API_SECRET

# Okruženje: "live" (pravi novac), "demo" (Bybit Demo Trading) ili "testnet"
BYBIT_ENV=demo

# true = bot samo simulira i ispisuje što bi napravio, ne šalje prave naloge
DRY_RUN=true

# Par koji se trguje (spot)
SYMBOL=BTCUSDT

# Ukupni kapital (u USDT) koji bot smije koristiti — bot NIKAD ne prelazi ovaj iznos
GRID_CAPITAL_USDT=100

# Grid postavke: raspon oko trenutne cijene (+/- %) i broj razina
GRID_RANGE_PCT=5
GRID_LEVELS=10

# Koliko sekundi između provjera stanja naloga
POLL_SECONDS=15

# --- Tržišni kontekst (besplatni javni izvori, bez ključeva) ---
# NAPOMENA: ovo NIJE prediktor cijene, samo sigurnosni filter + log.

# true = loguje Fear&Greed, BTC dominaciju i volatilnost periodično
MARKET_INSIGHT=true

# Koliko minuta između zapisa tržišnog konteksta u log
INSIGHT_INTERVAL_MIN=60

# true = raspon grida se računa iz stvarne volatilnosti (2-15%) umjesto
# fiksnog GRID_RANGE_PCT
DYNAMIC_RANGE=false

# true = bot obustavlja NOVE kupnje kad je Fear&Greed ispod praga
# (postojeći nalozi i prodaje i dalje rade normalno)
PAUSE_ON_EXTREME_FEAR=false
FEAR_GREED_PAUSE_BELOW=15
